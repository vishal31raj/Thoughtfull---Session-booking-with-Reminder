# Local development (outside Docker). Copy to backend/.env.
# Docker Compose injects its own values. Do not commit real secrets.

DATABASE_URL=postgresql://thoughtfull:thoughtfull@localhost:5432/thoughtfull
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_DURATION_MINUTES=50
SLOT_INTERVAL_MINUTES=60
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_MS=120000
WORKER_MAX_ATTEMPTS=5
SEED_ON_START=false

# Automated tests use thoughtfull_test, created by docker/init-db.sql.
# DATABASE_URL=postgresql://thoughtfull:thoughtfull@localhost:5432/thoughtfull_test
